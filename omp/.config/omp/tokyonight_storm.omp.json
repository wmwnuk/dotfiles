{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue-bell": "#9aa5ce",
    "blue-black": "#565f89",
    "celeste-blue": "#b4f9f8",
    "light-sky-blue": "#7dcfff",
    "main-bg": "#24283b",
    "pastal-grey": "#cfc9c2",
    "pistachio-green": "#9ece6a",
    "t-background": "p:main-bg",
    "terminal-black": "#414868",
    "terminal-blue": "#7aa2f7",
    "terminal-green": "#73daca",
    "terminal-magenta": "#bb9af7",
    "terminal-red": "#f7768e",
    "terminal-white": "#c0caf5",
    "terminal-yellow": "#e0af68",
    "white-blue": "#a9b1d6"
  },
  "secondary_prompt": {
    "template": "❯❯ ",
    "foreground": "p:terminal-blue",
    "background": "transparent"
  },
  "transient_prompt": {
    "template": "❯ ",
    "foreground": "p:terminal-blue",
    "background": "transparent"
  },
  "terminal_background": "p:t-background",
  "console_title_template": " {{ .Folder }} :: {{if .Root}}Admin{{end}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "style": "powerlevel"
          },
          "template": "<b>{{ .Path }}</b> ",
          "foreground": "p:terminal-blue",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "mapped_shell_names": {
              "bash": "\udb84\udd83",
              "cmd": "\uebc4",
              "fish": "\ue795",
              "powershell": "\ue62a",
              "pwsh": "\uebc7",
              "tcsh": "\ue795",
              "zsh": "\ue691"
            }
          },
          "template": "{{- .Name }} ",
          "foreground": "p:celeste-blue",
          "type": "shell",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "\ue0a0 ",
            "cache_duration": "none",
            "fetch_status": true
          },
          "template": "{{ .HEAD}} {{ if gt .Behind 0 }}{{ .Behind}}\u21e3 {{ end }}{{ if gt .Ahead 0 }}{{ .Ahead}}\u21e1 {{ end }}{{ if .Staging.Changed }}<p:terminal-blue>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <p:terminal-yellow>{{ .Working.String }}</>{{ end }} ",
          "foreground": "p:pistachio-green",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:terminal-red{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0)}}p:light-sky-blue {{ end }}",
            "{{ if gt .Ahead 0 }}p:terminal-blue{{ end }}",
            "{{ if gt .Behind 0 }}p:celeste-blue{{ end }}"
          ]
        },
        {
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "template": "{{ if .Error }}<p:terminal-red>{{- .Code -}} \uf467</> {{ else }}<p:pistachio-green>\uf42e</> {{ end }}",
          "type": "status",
          "style": "plain"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "❯",
          "foreground": "p:pistachio-green",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
